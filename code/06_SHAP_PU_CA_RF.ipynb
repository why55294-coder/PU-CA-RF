 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d5af4fa5-1df8-402a-bc82-9e290513aed6",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import rasterio\n",
    "import os\n",
    "import glob\n",
    "\n",
    "import shap\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 1.Paths\n",
    "# ==================================================\n",
    "\n",
    "folder = str(config.FEATURES)\n",
    "label_file = str(config.SAMPLE_PUL)\n",
    "out_dir = str(config.OUTPUT / \"pu_ca_rf_shap\")\n",
    "\n",
    "os.makedirs(out_dir, exist_ok=True)\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 2.Read RF and CA TIF\n",
    "# ==================================================\n",
    "\n",
    "rf_files = sorted(\n",
    "    glob.glob(folder + r\"\\*_RF.tif\")\n",
    ")\n",
    "\n",
    "ca_files = sorted(\n",
    "    glob.glob(folder + r\"\\*_CA.tif\")\n",
    ")\n",
    "\n",
    "\n",
    "all_files = rf_files + ca_files\n",
    "\n",
    "\n",
    "print(\"RF:\", len(rf_files),\n",
    "      \"CA:\", len(ca_files))\n",
    "\n",
    "\n",
    "print(\"Total variables:\",\n",
    "      len(all_files))\n",
    "\n",
    "\n",
    "# Check\n",
    "\n",
    "if len(all_files) != 22:\n",
    "    raise Exception(\n",
    "        \"The input variables are not 22. Please check the tif files\"\n",
    "    )\n",
    "\n",
    "# =========================\n",
    "# 2. reference grid (unified raster)\n",
    "# =========================\n",
    "ref_path = rf_files[0]\n",
    "\n",
    "with rasterio.open(ref_path) as ref:\n",
    "    ref_shape = (ref.height, ref.width)\n",
    "    profile = ref.profile.copy()\n",
    "    h, w = ref_shape\n",
    "\n",
    "# =========================\n",
    "# 3. Raster alignment function (independent of CRS)\n",
    "# =========================\n",
    "def align_no_crs(f):\n",
    "\n",
    "    with rasterio.open(f) as src:\n",
    "        data = src.read(1).astype(np.float32)\n",
    "\n",
    "        out = np.full(ref_shape, np.nan, dtype=np.float32)\n",
    "\n",
    "        hh = min(h, data.shape[0])\n",
    "        ww = min(w, data.shape[1])\n",
    "\n",
    "        out[:hh, :ww] = data[:hh, :ww]\n",
    "\n",
    "    return out\n",
    "\n",
    "# ==================================================\n",
    "# 3.Feature names\n",
    "# ==================================================\n",
    "\n",
    "feature_names=[]\n",
    "\n",
    "\n",
    "for f in rf_files:\n",
    "\n",
    "    name=os.path.basename(f)\n",
    "\n",
    "    name=name.replace(\n",
    "        \".tif\",\n",
    "        \"\"\n",
    "    )\n",
    "\n",
    "    feature_names.append(name)\n",
    "\n",
    "\n",
    "\n",
    "for f in ca_files:\n",
    "\n",
    "    name=os.path.basename(f)\n",
    "\n",
    "    name=name.replace(\n",
    "        \".tif\",\n",
    "        \"\"\n",
    "    )\n",
    "\n",
    "    feature_names.append(name)\n",
    "\n",
    "\n",
    "\n",
    "print(feature_names)\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 4.Read all TIFs and unify dimensions\n",
    "# ==================================================\n",
    "\n",
    "layers=[]\n",
    "\n",
    "\n",
    "for f in all_files:\n",
    "\n",
    "    data = align_no_crs(f)\n",
    "\n",
    "    layers.append(data)\n",
    "\n",
    "    print(\n",
    "        os.path.basename(f),\n",
    "        data.shape\n",
    "    )\n",
    "\n",
    "\n",
    "layers=np.stack(layers)\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Raster shape:\",\n",
    "    layers.shape\n",
    ")\n",
    "# ==================================================\n",
    "# 5.Convert to RF input format\n",
    "# ==================================================\n",
    "X = layers.reshape(\n",
    "        len(all_files),\n",
    "        -1\n",
    ").T\n",
    "\n",
    "\n",
    "print(\n",
    "    \"X:\",\n",
    "    X.shape\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "    \"X:\",\n",
    "    X.shape\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 6.Remove NaN\n",
    "# ==================================================\n",
    "\n",
    "mask=np.all(\n",
    "    np.isfinite(X),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "\n",
    "X_clean=X[mask]\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 7.Read PU training sample coordinates\n",
    "# ==================================================\n",
    "\n",
    "sample = pd.read_csv(\n",
    "    label_file,\n",
    "    sep=\",\",\n",
    "    header=None\n",
    ")\n",
    "\n",
    "\n",
    "print(sample.head())\n",
    "\n",
    "print(\n",
    "    \"Number of samples:\",\n",
    "    sample.shape\n",
    ")\n",
    "\n",
    "\n",
    "# Column 1: X coordinate\n",
    "# Column 2: Y coordinate\n",
    "# Column 3: Label\n",
    "\n",
    "sample_x = sample.iloc[:,0].values\n",
    "\n",
    "sample_y = sample.iloc[:,1].values\n",
    "\n",
    "sample_label = sample.iloc[:,2].values\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Label statistics:\",\n",
    "    np.unique(\n",
    "        sample_label,\n",
    "        return_counts=True\n",
    "    )\n",
    ")\n",
    "# ==================================================\n",
    "# 8.Match TIF pixels according to coordinates\n",
    "# ==================================================\n",
    "\n",
    "from rasterio.transform import rowcol\n",
    "\n",
    "\n",
    "# Reference raster transform\n",
    "\n",
    "with rasterio.open(ref_path) as src:\n",
    "\n",
    "    transform = src.transform\n",
    "\n",
    "\n",
    "\n",
    "rows_sample, cols_sample = rowcol(\n",
    "\n",
    "    transform,\n",
    "\n",
    "    sample_x,\n",
    "\n",
    "    sample_y\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "rows_sample = np.array(rows_sample)\n",
    "\n",
    "cols_sample = np.array(cols_sample)\n",
    "\n",
    "\n",
    "\n",
    "# Remove out-of-bounds points\n",
    "\n",
    "valid = (\n",
    "\n",
    "    (rows_sample >=0) &\n",
    "    (rows_sample < h) &\n",
    "    (cols_sample >=0) &\n",
    "    (cols_sample < w)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "rows_sample = rows_sample[valid]\n",
    "\n",
    "cols_sample = cols_sample[valid]\n",
    "\n",
    "sample_label = sample_label[valid]\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Valid training points:\",\n",
    "    len(sample_label)\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 9.Extract 22 variables corresponding to training samples\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "sample_index = (\n",
    "\n",
    "    rows_sample * w\n",
    "\n",
    "    +\n",
    "\n",
    "    cols_sample\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# Extract from all-pixel X\n",
    "\n",
    "X_shap = X[sample_index]\n",
    "\n",
    "\n",
    "y_shap = sample_label\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "\"X_shap:\",\n",
    "X_shap.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "\"y_shap:\",\n",
    "y_shap.shape\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 10.Train PU-CA-RF\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "rf_shap = RandomForestClassifier(\n",
    "\n",
    "    n_estimators=300,\n",
    "\n",
    "    max_depth=None,\n",
    "\n",
    "    random_state=42,\n",
    "\n",
    "    n_jobs=-1\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "rf_shap.fit(\n",
    "\n",
    "    X_shap,\n",
    "\n",
    "    y_shap\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "\"SHAP RF training completed\"\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 11.SHAP calculation\n",
    "# ==================================================\n",
    "\n",
    "explainer = shap.TreeExplainer(\n",
    "\n",
    "    rf_shap\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "shap_values = explainer(\n",
    "\n",
    "    X_shap\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "\"SHAP calculation completed\"\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 12.Process SHAP dimensions\n",
    "# ==================================================\n",
    "\n",
    "sv = shap_values.values\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "\"Original SHAP dimensions:\",\n",
    "sv.shape\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "if sv.ndim == 3:\n",
    "\n",
    "    sv = sv[:,:,1]\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "\"Corrected SHAP dimensions:\",\n",
    "sv.shape\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 13.SHAP summary plot\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "shap.summary_plot(\n",
    "\n",
    "    sv,\n",
    "\n",
    "    X_shap,\n",
    "\n",
    "    feature_names=feature_names\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    os.path.join(\n",
    "\n",
    "        out_dir,\n",
    "\n",
    "        \"SHAP_summary.png\"\n",
    "\n",
    "    ),\n",
    "\n",
    "    dpi=300,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "plt.close()\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 14.SHAP feature importance\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "shap.summary_plot(\n",
    "\n",
    "    sv,\n",
    "\n",
    "    X_shap,\n",
    "\n",
    "    feature_names=feature_names,\n",
    "\n",
    "    plot_type=\"bar\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    os.path.join(\n",
    "\n",
    "        out_dir,\n",
    "\n",
    "        \"SHAP_bar.png\"\n",
    "\n",
    "    ),\n",
    "\n",
    "    dpi=300,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "plt.close()\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 15.Single-variable SHAP effect\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "pb_index = feature_names.index(\n",
    "\n",
    "    \"Pb_RF\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "shap.dependence_plot(\n",
    "\n",
    "    pb_index,\n",
    "\n",
    "    sv,\n",
    "\n",
    "    X_shap,\n",
    "\n",
    "    feature_names=feature_names\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    os.path.join(\n",
    "\n",
    "        out_dir,\n",
    "\n",
    "        \"Pb_RF_dependence.png\"\n",
    "\n",
    "    ),\n",
    "\n",
    "    dpi=300,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "plt.close()\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 16.Export SHAP table\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "df_shap = pd.DataFrame(\n",
    "\n",
    "    sv,\n",
    "\n",
    "    columns=feature_names\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "df_shap.to_csv(\n",
    "\n",
    "    os.path.join(\n",
    "\n",
    "        out_dir,\n",
    "\n",
    "        \"SHAP_all_variables.csv\"\n",
    "\n",
    "    ),\n",
    "\n",
    "    index=False\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "\"SHAP CSV saved successfully\"\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 17.Restore SHAP spatial distribution\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "full_shap = np.full(\n",
    "\n",
    "    (\n",
    "\n",
    "        X.shape[0],\n",
    "\n",
    "        len(feature_names)\n",
    "\n",
    "    ),\n",
    "\n",
    "    np.nan\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "full_shap[sample_index] = sv\n",
    "\n",
    "\n",
    "\n",
    "full_shap = full_shap.reshape(\n",
    "\n",
    "    h,\n",
    "\n",
    "    w,\n",
    "\n",
    "    len(feature_names)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "# ==================================================\n",
    "# 18.Output SHAP spatial TIF\n",
    "# ==================================================\n",
    "\n",
    "\n",
    "for i,name in enumerate(feature_names):\n",
    "\n",
    "\n",
    "    out_tif = os.path.join(\n",
    "\n",
    "        out_dir,\n",
    "\n",
    "        name+\"_SHAP.tif\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    profile.update(\n",
    "\n",
    "        dtype=\"float32\",\n",
    "\n",
    "        count=1,\n",
    "\n",
    "        nodata=np.nan\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    with rasterio.open(\n",
    "\n",
    "        out_tif,\n",
    "\n",
    "        \"w\",\n",
    "\n",
    "        **profile\n",
    "\n",
    "    ) as dst:\n",
    "\n",
    "\n",
    "        dst.write(\n",
    "\n",
    "            full_shap[:,:,i]\n",
    "            .astype(\"float32\"),\n",
    "\n",
    "            1\n",
    "\n",
    "        )\n",
    "\n",
    "\n    \n    "    print(\n",
    "        name,\n",
    "        \"Completed\"\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "print(\"======================\")\n",
    "print(\"PU-CA-RF SHAP all completed\")\n",
    "print(\"======================\")"
   ]
  }
 ],
